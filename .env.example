# Copy to .env and fill in real values. Never commit the real .env (it is gitignored).

# --- Flask ---
SECRET_KEY=change_me_to_a_random_secret

# --- Mealie ---
MEALIE_API_URL=http://mealie:9000
MEALIE_FRONTEND_URL=https://your-mealie-domain.example
MEALIE_TOKEN=your_mealie_api_token
MEALIE_ACTIVE_LIST_ID=your_active_shopping_list_id
MEALIE_STAPLES_LIST_ID=your_staples_list_id

# --- AI (Anthropic Claude) ---
# Haiku for the small calls; Sonnet for the weekly plan and the chat agent.
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional overrides (defaults shown):
# AI_MODEL=claude-haiku-5-5          # parsing, nutrition, shopping, email copy
# AI_PLAN_MODEL=claude-sonnet-5-5    # weekly meal plan
# AI_PLAN_EFFORT=medium
# AI_CHAT_MODEL=claude-sonnet-5-5    # tool-using chat agent
# AI_CORE_EFFORT=low       # one-shot calls: low | medium | high | xhigh | max
# AI_CHAT_EFFORT=medium    # tool-using chat agent

# --- SMTP (email briefings) ---
#
# SMTP_USER and SMTP_PASSWORD are OPTIONAL. Leave both empty to relay through a
# host that authorises you by IP rather than by credential (the lab does this:
# one postfix relay holds the only provider password and everything else reaches
# it unauthenticated). When they are empty, STARTTLS and AUTH are both skipped,
# which is required against such a relay: it typically presents a self-signed
# certificate that starttls() rejects, and runs no SASL backend, so AUTH fails.
#
# Set them to talk to a provider directly, and it behaves exactly as before.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=your_email@example.com
SMTP_FROM_NAME=Mealie Companion

# --- App / household ---
MEALIE_PLANNER_APP_URL=https://mealie-planner.example
FAMILY_NAMES="Nathan & Kristin"                        # Used for the dashboard branding and email headers
FAMILY_MEMBERS="Nathan, Kristin, Charlotte (11), Leah (6)" # Details of household members (optional, helps AI context)
FAMILY_RECIPIENT_EMAILS=person_a@example.com,person_b@example.com
APP_TIMEZONE=America/New_York

# Optional: seconds to cache recipe details in-process (default 600)
# RECIPE_CACHE_TTL=600

# --- Recipe API (optional, for fast USDA nutrition lookup) ---
# RECIPE_API_KEY=your_recipe_api_key


